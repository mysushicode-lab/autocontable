# ══════════════════════════════════════════════════════════════════════════════
# .env.local.example - Development environment overrides
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env.local and configure for local development
# .env.local is git-ignored and takes precedence over .env
#
# Usage:
#   cp .env.local.example .env.local
#   # Edit .env.local with your dev credentials
#

# ── Session Secret ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ── OAuth Development Callbacks ───────────────────────────────────────────────
# Register these URLs in Google/LinkedIn developer consoles for local testing

# Google OAuth - Add http://localhost:8000/api/auth/google/callback to authorized redirects
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# LinkedIn OAuth - Add http://localhost:8000/api/auth/linkedin/callback to authorized redirects
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

# ── Frontend URL ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev (faster, no Docker required)
DATABASE_URL=sqlite:///data/accounting.db

# Or use local PostgreSQL:
# DATABASE_URL=postgresql://autocontable:changeme@localhost:5432/autocontable
